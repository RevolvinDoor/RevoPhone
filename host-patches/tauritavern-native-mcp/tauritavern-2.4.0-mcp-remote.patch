+test('api.mcp remote snapshots transient headers and preserves the native outcome when cancelled', async () => {
+    const calls = [];
+    let resolveStart;
+    let resolveCall;
+    const started = new Promise(resolve => { resolveStart = resolve; });
+    const called = new Promise(resolve => { resolveCall = resolve; });
+    const { mcp } = await installHarness(async (command, args) => {
+        calls.push({ command, args });
+        if (command === 'start_remote_mcp_tool_call') return started;
+        if (command === 'call_remote_mcp_tool') return called;
+    });
+    const input = { connection: { endpoint: 'https://example.com/mcp', headers: { Authorization: 'Bearer initial' } }, nativeName: 'speak', argumentsJson: '{}' };
+    const controller = new AbortController();
+    const pending = mcp.remote.call(input, { signal: controller.signal });
+    input.connection.headers.Authorization = 'Bearer changed';
+    resolveStart();
+    while (calls.length < 2) await Promise.resolve();
+    assert.equal(calls[1].args.dto.connection.headers.Authorization, 'Bearer initial');
+    controller.abort();
+    await Promise.resolve();
+    assert.equal(calls[2].command, 'cancel_remote_mcp_tool_call');
