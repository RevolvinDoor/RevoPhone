+#[tokio::test]
+async fn remote_calls_keep_credentials_transient_and_do_not_publish_registrations() {
+    use crate::dto::mcp_dto::{CallRemoteMcpToolDto, RemoteMcpConnectionDto};
+    let repository = Arc::new(MemoryRepository::default());
+    let gateway = Arc::new(FixedGateway::default());
+    let service = McpService::new(repository.clone(), gateway.clone());
+    let connection = RemoteMcpConnectionDto {
+        endpoint: "https://example.com/mcp".to_string(),
+        headers: BTreeMap::from([("Authorization".to_string(), "Bearer fixture".to_string())]),
+        protocol_version: McpProtocolVersionPreference::V2025_11_25,
+    };
+    let discovery = service.discover_remote_tools(connection.clone()).await.unwrap();
+    assert_eq!(discovery.0.tools.len(), 1);
+    service.start_call("remote-call").await.unwrap();
+    let outcome = service.call_remote_tool(CallRemoteMcpToolDto {
+        execution_call_id: "remote-call".to_string(),
+        connection,
+        native_name: "search".to_string(),
+        arguments_json: "{\"number\":9007199254740993}".to_string(),
+    }).await.unwrap();
+    assert!(matches!(outcome, McpCallOutcomeDto::KnownResponse { .. }));
+    assert_eq!(gateway.calls.lock().unwrap()[0].1["number"].as_u64(), Some(9_007_199_254_740_993));
+    assert_eq!(gateway.request_headers.lock().unwrap()[1]["Authorization"], "Bearer fixture");
+    assert!(repository.registrations.lock().unwrap().is_empty());
+    assert!(repository.catalogs.lock().unwrap().is_empty());
+    assert!(service.calls.get("remote-call").await.is_none());
