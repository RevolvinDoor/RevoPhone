+    if (signal?.aborted) { cancel(); return cancelledBeforeSend(); }
+    signal?.addEventListener('abort', cancel, { once: true });
+    try {
+        return await safeInvoke(commands.call, { dto });
+    } catch (error) {
+        cancel();
+        throw error;
+    } finally {
+        signal?.removeEventListener('abort', cancel);
+    }
+}
