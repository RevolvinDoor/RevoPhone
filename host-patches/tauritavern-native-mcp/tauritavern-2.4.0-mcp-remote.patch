@@ -0,0 +1,83 @@
+use crate::{
+    dto::mcp_dto::{
+        CallRemoteMcpToolDto, McpCallOutcomeDto, RemoteMcpConnectionDto,
+        RemoteMcpDiscoveryResultDto,
+    },
+    errors::ApplicationError,
+};
+use tt_domain::models::mcp::{McpEndpoint, McpRequestHeaders, validate_native_tool_name};
+
+use super::{
+    McpService,
+    call::{map_call_outcome, not_sent, parse_arguments},
+};
+
+impl McpService {
+    /// An extension-owned connection uses the shared gateway without publishing model tools
+    /// or persisting OAuth headers in the Manager's registration files.
+    pub async fn discover_remote_tools(
+        &self,
+        connection: RemoteMcpConnectionDto,
+    ) -> Result<RemoteMcpDiscoveryResultDto, ApplicationError> {
+        let endpoint = McpEndpoint::parse(connection.endpoint)?;
+        let headers = McpRequestHeaders::from(connection.headers);
+        let result = self
+            .gateway
+            .discover_tools(&endpoint, &headers, connection.protocol_version)
+            .await?;
+        Ok(RemoteMcpDiscoveryResultDto(result))
+    }
+
+    pub async fn call_remote_tool(
+        &self,
+        dto: CallRemoteMcpToolDto,
+    ) -> Result<McpCallOutcomeDto, ApplicationError> {
+        let CallRemoteMcpToolDto {
+            execution_call_id,
+            connection,
+            native_name,
+            arguments_json,
+        } = dto;
+        let Some(cancel) = self.calls.get(&execution_call_id).await else {
+            return Ok(not_sent(
+                "mcp.call_not_started",
+                "The remote tool call was not prepared or was cancelled before it started",
+            ));
+        };
+        let result = async {
+            if cancel.is_cancelled() {
+                return Ok(not_sent(
+                    "mcp.call_cancelled_before_send",
+                    "The tool request was cancelled before it started",
+                ));
+            }
+            if let Err(error) = validate_native_tool_name(&native_name) {
+                return Ok(not_sent("mcp.call_tool_name_invalid", error.to_string()));
+            }
+            let arguments = match parse_arguments(&arguments_json) {
+                Ok(arguments) => arguments,
+                Err(outcome) => return Ok(outcome),
+            };
+            let endpoint = match McpEndpoint::parse(&connection.endpoint) {
+                Ok(endpoint) => endpoint,
+                Err(error) => return Ok(not_sent("mcp.call_endpoint_invalid", error.to_string())),
+            };
+            let headers = McpRequestHeaders::from(connection.headers);
+            let outcome = self
+                .gateway
+                .call_tool(
+                    &endpoint,
+                    &headers,
+                    connection.protocol_version,
+                    &native_name,
+                    arguments,
+                    cancel,
+                )
+                .await?;
+            Ok(map_call_outcome(outcome))
+        }
+        .await;
+        self.calls.complete(&execution_call_id).await;
+        result
+    }
+}
