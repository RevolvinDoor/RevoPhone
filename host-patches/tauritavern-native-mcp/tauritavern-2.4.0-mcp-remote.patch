+/**
+ * Share cancellation and outcomes between Manager tests and extension-owned calls.
+ * @param {(command: string, args?: any) => Promise<any>} safeInvoke
+ * @param {Record<string, any>} input
+ * @param {{ signal?: AbortSignal }} options
+ * @param {{ start: string, call: string, cancel: string }} commands
+ * @param {string} idField
+ */
+async function invokeCall(safeInvoke, input, options, commands, idField) {
+    const signal = options?.signal;
+    if (signal?.aborted) return cancelledBeforeSend();
+    const id = globalThis.crypto.randomUUID();
+    const dto = structuredClone({ ...input, [idField]: id });
+    const cancel = () => {
